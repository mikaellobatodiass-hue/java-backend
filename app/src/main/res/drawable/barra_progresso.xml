<?xml version="1.0" encoding="utf-8"?>
<!-- Desenho da barra de progresso com as pontas arredondadas.
     "background" = parte cinza (fundo) / "progress" = parte preenchida.
     A cor da parte preenchida (verde ou vermelho) é definida pelo código Java. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinza_barra" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/verde_ok" />
                <corners android:radius="10dp" />
            </shape>
        </clip>
    </item>
</layer-list>
