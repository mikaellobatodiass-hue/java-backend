<?xml version="1.0" encoding="utf-8"?>
<!-- TELA 3 - Resumo da compra -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_claro"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ResumoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho verde escuro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_escuro"
            android:padding="16dp"
            android:text="@string/titulo_resumo"
            android:textColor="@color/branco"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Cartão com os valores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/fundo_cartao"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Orçamento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_orcamento_resumo"
                android:textColor="@color/texto_cinza"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtOrcamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Total da compra -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_resumo"
                android:textColor="@color/texto_cinza"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Saldo restante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_saldo_resumo"
                android:textColor="@color/texto_cinza"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Barra horizontal mostrando quanto do orçamento foi usado (0 a 100%) -->
            <ProgressBar
                android:id="@+id/barraOrcamento"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:max="100"
                android:progressBackgroundTint="@color/cinza_barra" />

            <!-- Texto com o percentual usado -->
            <TextView
                android:id="@+id/txtPercentual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texto_cinza"
                android:textSize="14sp" />

            <!-- Mensagem de parabéns ou de cuidado -->
            <TextView
                android:id="@+id/txtMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botões -->
        <Button
            android:id="@+id/btnVerDicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/verde_botao"
            android:text="@string/botao_ver_dicas"
            android:textColor="@color/branco"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnVoltarLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/verde_medio"
            android:text="@string/botao_voltar_lista"
            android:textColor="@color/branco"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
