<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de UM item da lista: CheckBox do produto + botão Editar ao lado.
     A ListaActivity "infla" (cria) este layout uma vez para cada produto do banco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- CheckBox com nome e preço; layout_weight="1" faz ele ocupar o espaço que sobra -->
    <CheckBox
        android:id="@+id/checkProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="8dp"
        android:textColor="@color/texto_escuro"
        android:textSize="17sp" />

    <!-- Botão que abre a tela de edição deste produto -->
    <Button
        android:id="@+id/btnEditar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/verde_medio"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/botao_editar"
        android:textColor="@color/branco"
        android:textSize="14sp" />
</LinearLayout>
