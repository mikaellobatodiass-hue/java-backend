<?xml version="1.0" encoding="utf-8"?>
<!-- TELA 1 - Início: ScrollView para a tela rolar se o teclado cobrir os campos -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_escuro"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Conteúdo da tela, um item embaixo do outro, centralizado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título do app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_app"
            android:textColor="@color/branco"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp"
            android:text="@string/subtitulo_app"
            android:textColor="@color/verde_suave"
            android:textSize="18sp" />

        <!-- Cartão branco com o campo do orçamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_cartao"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_orcamento"
                android:textColor="@color/texto_escuro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Campo numérico decimal para o orçamento -->
            <EditText
                android:id="@+id/editOrcamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:digits="0123456789.,"
                android:hint="@string/hint_orcamento"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="@color/texto_escuro"
                android:textSize="20sp" />

            <!-- Botão que abre a lista de compras -->
            <Button
                android:id="@+id/btnComecar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/verde_botao"
                android:text="@string/botao_comecar"
                android:textColor="@color/branco"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
