        <item name="colorSecondary">@color/verde_medio</item>
        <!-- Cor de fundo padrão das telas -->
        <item name="android:windowBackground">@color/verde_claro</item>
    </style>

    <style name="Theme.CarrinhoCerto" parent="Base.Theme.CarrinhoCerto" />
</resources>
